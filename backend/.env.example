PORT=5000

# Local MongoDB, or a free MongoDB Atlas cluster URI
MONGO_URI=mongodb://127.0.0.1:27017/nabad

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=replace_this_with_a_different_long_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend origin allowed to call this API (for CORS + cookies)
CLIENT_ORIGIN=http://localhost:3000

# Used later for password-reset emails (Task 3). A free Mailtrap/Ethereal
# account is fine for dev/demo purposes.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nabad <no-reply@nabad.app>"
